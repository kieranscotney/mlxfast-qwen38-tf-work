     }
 
     pub fn threadgroupBytes(l: Layout) usize {
+        // the plain reg kernel keeps its operands in registers: only the K splits' partial sums use threadgroup memory
+        if (l.reg and !l.swiglu and true) return @max(l.sk -| 1, 1) * l.prompt_tn * 16 * 32 * @sizeOf(f32);
