+
+/// The drafter's K splits: projection.split, except the tap fusion (K = five hidden widths), whose 160 column tiles
+/// leave the GPU short of threadgroups for a decoded round's few rows; sixteen splits double them.
+fn draftSplit(n: usize, k: usize) !u32 {
+    if (k >= 4 * n and n % 32 == 0 and k % (64 * 16) == 0) return 16;
+    return @import("../projection.zig").split(n, k);
+}
