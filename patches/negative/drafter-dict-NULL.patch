+/// A reg adapter's metadata as a u16 index into its distinct (scale, bias) words, for decoded drafter windows.
+fn attachDict(a: std.mem.Allocator, device: @import("metal").Device, adapter: *core.affine4_lane.Adapter) !void {
+    if (!adapter.projection.reg) return;
+    const pi = @import("../pair_index.zig");
+    const count = adapter.projection.metadata_bytes / 4;
+    const words = adapter.metadata.slice(u32, count);
+    const index = try a.alloc(u16, count);
+    defer a.free(index);
+    const table = try a.alloc(u32, pi.table_limit);
+    defer a.free(table);
+    const slots = try a.alloc(u32, 2 * pi.table_limit);
+    defer a.free(slots);
+    const distinct = pi.indexPairs(words, index, table, slots) orelse return;
+    try adapter.withDict(a, device, index, table[0..distinct]);
+}
