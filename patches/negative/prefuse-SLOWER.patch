+        e.setPipeline(pair_pre);
+        bind(e, .{ r.b.query, r.b.key, r.b.value, r.b.decay, r.b.mixing, r.b.state, r.b.parents, r.b.segments }, 0);
+        e.setValue(r.p, 8);
