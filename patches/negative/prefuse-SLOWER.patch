+    pub fn forwardPairPre(r: Round, e: metal.ComputeEncoder, pre_rows: metal.Pipeline, pair: metal.Pipeline, pair_pre: metal.Pipeline, post_rows: metal.Pipeline, beside: ?Beside) !void {
