@@ -19,6 +19,17 @@ pub fn split(n: usize, k: usize) !u32 {
     return slices;
 }
 
+/// K splits for the drafter's linears below 4 bits: their codes are half the bytes a group for the same unpack and
+/// tensor-op work, so one SIMD group a tile cannot keep enough of the stream in flight; up to 4096 SIMD groups a launch
+/// and 4 groups a chain. 4-bit linears keep `split`. Only drafter launches take it: their sums are the drafts' only.
+pub fn draftSplit(n: usize, k: usize, bits: u8) !u32 {
+    if (bits >= 4) return split(n, k);
+    if (n == 0 or k == 0 or n % 4 != 0 or k % 64 != 0) return error.BadProjectionShape;
+    var slices: u32 = 1;
+    while (slices < 8 and (n + 31) / 32 * slices < 4096 and k / 64 / (2 * slices) >= 4) slices *= 2;
+    return slices;
+}
+
 /// K splits fastest on an M5 Ultra, each shape streamed over every layer's matrix (tf-qwen27-bench QWEN27_DISTINCT).
 fn m5Split(n: usize, k: usize) ?u32 {
     const table = [_]struct { n: usize, k: usize, sk: u32 }{ .{ .n = 10240, .k = 5120, .sk = 2 }, .{ .n = 6240, .k = 5120, .sk = 4 }, .{ .n = 5120, .k = 6144, .sk = 4 }, .{ .n = 12288, .k = 5120, .sk = 2 }, .{ .n = 2048, .k = 5120, .sk = 8 }, .{ .n = 5120, .k = 17408, .sk = 4 } };
