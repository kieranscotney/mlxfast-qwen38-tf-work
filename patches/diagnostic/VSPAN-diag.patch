+
+var span_n: u64 = 0;
+var span_sum: f64 = 0;
+fn spanNote() void {
+    const seg = @import("core").segments;
+    if (seg.diag_n == 0) return;
+    var vs: f64 = 1e30;
+    var ve: f64 = 0;
+    for (seg.diag_cbs[0..seg.diag_n]) |c| {
+        c.wait();
+        vs = @min(vs, c.gpuStart());
+        ve = @max(ve, c.gpuEnd());
+    }
+    for (seg.diag_cbs[0..seg.diag_n]) |c| c.release();
+    seg.diag_n = 0;
+    if (ve - vs > 0.1) return;
+    span_n += 1;
+    span_sum += ve - vs;
+    if (span_n % 300 == 0) std.log.warn("VSPAN n={d} verify_span={d:.3}ms", .{ span_n, span_sum / @as(f64, @floatFromInt(span_n)) * 1e3 });
+}
