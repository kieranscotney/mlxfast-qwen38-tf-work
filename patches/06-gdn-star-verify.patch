+/// One compact segment of three or more rows: row 0 from the root, then children of row 0 only, in row order.
+fn isStar(plan: Plan) bool {
+    if (!plan.compact or plan.segments.len != 1 or plan.parents.len < 3 or plan.slot_steps.len != plan.parents.len) return false;
+    const seg = plan.segments[0];
+    if (seg.first != 0 or seg.rows != plan.parents.len) return false;
+    for (plan.parents, plan.slot_steps, 0..) |parent, step, row| {
+        if (parent != (if (row == 0) @as(i32, -1) else 0) or step.row != row) return false;
+    }
+    return true;
+}
